# WorkNear Environment Variables Configuration
# Copy this file to .env for local development

# Application Port (Automatically provided by Render in production)
PORT=8000

# Database URL (SQLite default for local development, PostgreSQL for Render managed DB)
DATABASE_URL=sqlite:///worknear.db
# Example for PostgreSQL on Render:
# DATABASE_URL=postgresql://user:password@hostname/dbname

# JWT Authentication Secret Key
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Frontend CORS Allowed Origins (comma-separated, leave blank or * for all)
FRONTEND_URL=https://worknear.onrender.com,http://localhost:5173

# Python Version for Render
PYTHON_VERSION=3.11.9
